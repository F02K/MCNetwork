{
  "name": "mcnetwork",
  "version": "0.1.0",
  "description": "Management tool for Minecraft server networks (proxy + backend servers)",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node dist/mcnetwork.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "build:agent": "node scripts/build-agent.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "c8": "^10.1.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  }
}
